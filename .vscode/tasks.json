{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: dev server",
      "type": "npm",
      "script": "dev",
      "path": "tech-unfiltered",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "ready|Starting",
          "endsPattern": "ready|started server"
        }
      },
      "presentation": {
        "group": "tech-unfiltered",
        "panel": "dedicated"
      }
    },
    {
      "label": "Frontend: lint",
      "type": "npm",
      "script": "lint",
      "path": "tech-unfiltered",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Frontend: build",
      "type": "npm",
      "script": "build",
      "path": "tech-unfiltered",
      "problemMatcher": []
    },
    {
      "label": "Backend: start local stack",
      "type": "shell",
      "command": "docker compose up --build",
      "options": {
        "cwd": "${workspaceFolder}/agi-backend"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "agi-backend",
        "panel": "dedicated"
      }
    },
    {
      "label": "Backend: stop local stack",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}/agi-backend"
      },
      "problemMatcher": []
    }
  ]
}
