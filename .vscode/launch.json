{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/tech-unfiltered"
    },
    {
      "name": "Backend: main.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agi-backend/main.py",
      "cwd": "${workspaceFolder}/agi-backend",
      "console": "integratedTerminal"
    }
  ]
}
