{
  "files.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.DS_Store": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/chroma_data": true,
    "**/ollama_data": true,
    "**/headscale_data": true,
    "**/tailscale_data": true,
    "**/prometheus_data": true,
    "**/grafana_data": true
  },
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.tsdk": "tech-unfiltered/node_modules/typescript/lib",
  "python.analysis.extraPaths": [
    "agi-backend"
  ],
  "docker.composeBuild": true
}
